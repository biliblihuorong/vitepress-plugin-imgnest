{
  "name": "vitepress-plugin-imgnest",
  "version": "0.0.2",
  "description": "ImgNest responsive images plugin for VitePress",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "vitepress",
    "vitepress-plugin",
    "imgnest",
    "responsive-images",
    "srcset",
    "image-optimization"
  ],
  "license": "MIT",
  "author": "misakashell",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biliblihuorong/vitepress-plugin-imgnest.git"
  },
  "bugs": {
    "url": "https://github.com/biliblihuorong/vitepress-plugin-imgnest/issues"
  },
  "homepage": "https://github.com/biliblihuorong/vitepress-plugin-imgnest#readme",
  "peerDependencies": {
    "vitepress": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
